auto-install-peers=true
strict-peer-dependencies=false

# Skip pnpm's "X new package's build scripts must be approved" interactive
# prompt. The exact set of packages we DO want to build is enumerated under
# `onlyBuiltDependencies` in pnpm-workspace.yaml; everything else is silently
# skipped instead of pausing the install.
ignore-scripts=false

# Some packages in the dep graph are missing the `time` field in their
# registry metadata, which trips pnpm's `minimumReleaseAge` filter
# (ERR_PNPM_MISSING_TIME). Falling back to highest-resolution mode skips that
# check. Repo-local so cloners don't have to discover the workaround.
resolution-mode=highest
