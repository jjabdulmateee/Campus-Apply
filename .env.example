# =============================================================================
# Campus Apply / PakApply — environment configuration
#
# Copy this file to `.env` (in the same directory) and fill in real values.
# `.env` is git-ignored and is loaded automatically by:
#   - the API server  (via `node --env-file-if-exists=../../.env ...`)
#   - the Vite dev server (via Vite's built-in dotenv loader)
# =============================================================================

# ─── General ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Backend API server (artifacts/api-server) ─────────────────────────────
# Port the Express server listens on.
PORT=5000

# ─── Database (development vs production) ───────────────────────────────────
# Local prototyping only — compares live DB to schema and applies drift:
#   pnpm run db:push
#
# Production / staging — generate then apply versioned migrations:
#   pnpm run db:generate -- --name describe_your_change
#   pnpm run db:migrate
#
# Migration SQL lives in lib/db/migrations/
# (Docker, local install, RDS, Supabase, Neon, etc.).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pakapply

# JWT signing secret — REQUIRED. The server will refuse to start if unset.
# Generate a secure value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated browser origins allowed to call the API with credentialed cookies.
# Defaults to http://localhost:3000 when unset.
CORS_ORIGINS=http://localhost:3000

# Demo accounts (student@pakmail.pk / demo123, admin@pakmail.pk / admin123, …)
# are NOT created automatically. Set to "true" to seed them on a local dev
# database. Ignored entirely when NODE_ENV=production.
SEED_DEMO_ACCOUNTS=false

# ─── Frontend Vite app (artifacts/pakistan-apply) ──────────────────────────
# In dev these two are set automatically by the `dev` script via cross-env;
# you do NOT normally need to override them here.
#   PORT=3000
#   BASE_PATH=/

# Where the browser sends API calls in PRODUCTION builds (e.g. when serving
# the static `dist/public` folder from a CDN). Leave blank in dev — the Vite
# dev server proxies /api → http://localhost:${PORT_OF_BACKEND}.
VITE_API_URL=

# Optional: override the proxy target the Vite dev server forwards /api to.
# Defaults to http://localhost:5000.
VITE_API_PROXY_TARGET=

# Public URL of the frontend, used inside verification + recommendation emails.
APP_URL=http://localhost:3000

# ─── SMTP (optional — when unset, links are logged for dev) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Object Storage ─────────────────────────────────────────────────────────
# Local disk storage (default when Replit GCS vars are unset).
# Set STORAGE_BACKEND=gcs to force Replit/Google Cloud sidecar mode.
STORAGE_BACKEND=local

# Directory for uploaded files (avatars, transcripts, locker docs).
# Relative paths resolve from artifacts/api-server/.
LOCAL_UPLOAD_DIR=uploads

# Replit GCS sidecar — only needed when STORAGE_BACKEND=gcs
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
